{
  "manifest_version": 3,
  "name": "JobMap ApplyFlow Bridge",
  "version": "0.4.0",
  "description": "Fills only user-approved, source-backed JobMap application fields on allowlisted employer forms.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://jobmap-ten.vercel.app/*",
    "http://localhost:3000/*",
    "http://localhost:5173/*",
    "https://boards.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://job-boards.eu.greenhouse.io/*",
    "https://stripe.com/jobs/*",
    "https://jobs.lever.co/*",
    "https://jobs.eu.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "https://jobicy.com/*",
    "https://weworkremotely.com/*",
    "https://remoteok.com/*",
    "https://remotive.com/*",
    "https://www.ycombinator.com/*",
    "https://news.ycombinator.com/*",
    "https://reliefweb.int/*"
  ],
  "action": { "default_title": "JobMap ApplyFlow Bridge", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["https://jobmap-ten.vercel.app/*", "http://localhost:3000/*", "http://localhost:5173/*"],
      "js": ["capture.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://boards.greenhouse.io/*", "https://job-boards.greenhouse.io/*", "https://job-boards.eu.greenhouse.io/*", "https://stripe.com/jobs/*", "https://jobs.lever.co/*", "https://jobs.eu.lever.co/*", "https://jobs.ashbyhq.com/*"],
      "js": ["adapters.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://jobicy.com/*", "https://weworkremotely.com/*", "https://remoteok.com/*", "https://remotive.com/*", "https://www.ycombinator.com/*", "https://news.ycombinator.com/*", "https://reliefweb.int/*"],
      "js": ["adapters.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": { "service_worker": "background.js", "type": "module" }
}